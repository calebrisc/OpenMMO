OPENMMO_LOGIN_IMAGE=ghcr.io/openmmo-org/openmmo-login:latest
OPENMMO_GAME_IMAGE=ghcr.io/openmmo-org/openmmo-game:latest
OPENMMO_SESSION_SECRET=replace-with-a-long-random-value
OPENMMO_GAME_PRIVATE_KEY_PATH=C:/OpenMMO/secrets/game.private.pem
# Reserved; runtime custom map loading is not implemented yet.
OPENMMO_CUSTOM_MAPS_PATH=C:/OpenMMO/custom-maps

GAME_SERVER_PUBLIC_IPV4=203.0.113.10
GAME_SERVER_PUBLIC_IPV6=::ffff:cb00:710a
GAME_SERVER_PORT=7777
GAME_SERVER_LOCAL_ADDRESS=203.0.113.10
GAME_SERVER_LOCAL_HOSTNAME=game.openmmo.dev

LOGIN_DB_NAME=openmmo_login_db
LOGIN_DB_USER=openmmo_login_user
LOGIN_DB_PASSWORD=replace-with-a-random-password
LOGIN_DB_SEED_DEV=false

GAME_DB_NAME=openmmo_game_db
GAME_DB_USER=openmmo_game_user
GAME_DB_PASSWORD=replace-with-another-random-password
GAME_DB_SEED_DEV=false
